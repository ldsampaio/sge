# Copy to `src-tauri/.live-test.env` (git-ignored, NEVER committed) and fill in.
# Live verification scripts (v1.4 phases 21/22/26) source that file.
#
# Sandbox safety contract (structural):
# - Test mail is sent ONLY to SGE_LIVE_SELF (your own address). Never to others.
# - Mutating IMAP ops (APPEND/MOVE/STORE/EXPUNGE/CREATE) target ONLY the
#   per-run sandbox folder `SGE-Test-<run-id>`. Existing mail/folders untouched.
# - Pre-flight guard aborts on any out-of-sandbox target; run ends with cleanup.

# IMAP (incoming)
SGE_LIVE_IMAP_HOST=mail.utfpr.edu.br
SGE_LIVE_IMAP_PORT=993
SGE_LIVE_IMAP_USER=your-user
SGE_LIVE_IMAP_PASS=your-password

# SMTP (outgoing)
SGE_LIVE_SMTP_HOST=smtp.utfpr.edu.br
SGE_LIVE_SMTP_PORT=587
SGE_LIVE_SMTP_USER=your-user
SGE_LIVE_SMTP_PASS=your-password

# Own address — the ONLY permitted recipient/sender for live-test mail.
SGE_LIVE_SELF=you@example.com
