{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app's windows: main, compose-*, llm-config",
  "windows": [
    "main",
    "compose-*",
    "llm-config"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "sge-laya",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
